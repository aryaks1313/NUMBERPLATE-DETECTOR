# Core app configuration. Change the admin password and session secret locally.
DATABASE_URL=sqlite:///./service_gate.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
SESSION_SECRET=replace-with-a-long-random-secret
YOLO_MODEL_PATH=models/best.pt

# PaddleOCR confidence gates. Recognition below either threshold is hidden.
PLATE_MIN_DETECTION_CONFIDENCE=0.35
OCR_MIN_CONFIDENCE=0.75
PADDLEOCR_DEVICE=cpu
# Optional local PaddleOCR 3.x model directories (leave blank for automatic download).
PADDLEOCR_DETECTION_MODEL_DIR=
PADDLEOCR_RECOGNITION_MODEL_DIR=
# Optional alternate model source if the default host is unreachable: BOS
PADDLE_PDX_MODEL_SOURCE=BOS
VIDEO_SAMPLE_FPS=4

# Capacity per advisor for each time block.
BOOKING_SLOT_MINUTES=30
BOOKINGS_PER_ADVISOR_SLOT=2

# Gmail API OAuth: no Gmail SMTP password is needed.
EMAIL_ENABLED=true
EMAIL_AUTH_METHOD=oauth
GMAIL_OAUTH_CLIENT_FILE=
GMAIL_OAUTH_TOKEN_FILE=gmail-oauth-token.json

# Optional legacy SMTP mode: set EMAIL_AUTH_METHOD=smtp to use these instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Meta WhatsApp Cloud API. Use an approved template with four body variables:
# plate, customer, advisor, appointment.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v27.0
WHATSAPP_TEMPLATE_NAME=service_gate_arrival
WHATSAPP_TEMPLATE_LANGUAGE=en_US
